# ===================================================================
# UPAP — Universal Professions AI Platform
# انسخ هذا الملف إلى .env.local واملأ القيم
# كل الخدمات المذكورة هنا مجانية 100%
# ===================================================================

# ── الذكاء الاصطناعي الأساسي ───────────────────────────────────────
# سجّل مجاناً: https://openrouter.ai
# اختر موديلات تنتهي بـ :free (مثل: meta-llama/llama-3.1-8b-instruct:free)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_VISION_MODEL=google/gemini-flash-1.5:free

# ── الذكاء الاصطناعي الاحتياطي (fallback) ─────────────────────────
# مفتاح مجاني: https://aistudio.google.com
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# ── قاعدة البيانات ─────────────────────────────────────────────────
# مشروع مجاني: https://supabase.com → New Project
# بعد الإنشاء: Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# ── الأمان ─────────────────────────────────────────────────────────
# مفتاح سري لحماية الـ Webhooks — اكتب أي نص عشوائي طويل
AGENT_API_SECRET=change-this-to-a-random-secret-string-min-32-chars

# ── محفظة USDT (للمدفوعات) ─────────────────────────────────────────
# عنوان محفظتك على شبكة Tron (TRC20) من Binance أو أي محفظة
USDT_WALLET_ADDRESS=T...
TRON_FULL_NODE=https://api.trongrid.io
# مفتاح TronGrid مجاني: https://www.trongrid.io/register
TRON_API_KEY=
